<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/splash_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:padding="15dp"
                android:src="@drawable/small_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/splash_logo">

                <TextView
                    android:id="@+id/json_tv_as_highest_security_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AS Highest Security Level Reached:"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/json_tv_as_highest_security_level_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/json_tv_match_highest_security_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Match Highest Security Level Reached:"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/json_tv_match_highest_security_level_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/json_tv_encrypted_templates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Has encrypted templates:"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/json_tv_encrypted_templates_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/json_tv_has_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Has image:"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/json_tv_has_image_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/json_tv_has_hr_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Has HR image:"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/json_tv_has_hr_image_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/json_tv_has_thumbnail_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Has Thumbnail:"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/json_tv_has_thumbnail_image_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/json_tv_json"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JSON:"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/json_tv_json_response"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>